{
  "name": "@yuiju/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -w run generate:extensions && next dev --port 5179",
    "build": "pnpm -w run generate:extensions && next build",
    "build:vercel": "mkdir -p ../../data/config && cp ../../yuiju.config.vercel.json ../../data/config/config.json && pnpm run build",
    "start": "pnpm -w run generate:extensions && next start --port 6100",
    "type-check": "pnpm -w run generate:extensions && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@yuiju/shared": "workspace:*",
    "lucide-react": "catalog:",
    "monaco-editor": "0.55.1",
    "next": "16.1.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3"
  }
}
