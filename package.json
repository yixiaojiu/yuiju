{
  "name": "yuiju",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "lint": "biome lint . --diagnostic-level=error",
    "format:write": "biome format . --write",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pnpm run build:dashboard && pm2 restart ecosystem.config.js",
    "start": "pnpm run build:dashboard && pm2 start ecosystem.config.js",
    "start:dashboard": "pnpm --filter @yuiju/dashboard run start",
    "start:character-runtime": "pnpm --filter @yuiju/character-runtime run start",
    "start:world-simulator": "pnpm --filter @yuiju/world-simulator run start",
    "start:python": "cd packages/python && uv run uvicorn server:app --host 0.0.0.0 --port 9196",
    "build:site": "pnpm --filter @yuiju/site run build",
    "build:dashboard": "pnpm --filter @yuiju/dashboard run build",
    "dev:site": "pnpm --filter @yuiju/site run dev",
    "dev:dashboard": "pnpm --filter @yuiju/dashboard run dev",
    "dev:character-runtime": "pnpm --filter @yuiju/character-runtime run dev",
    "dev:character-runtime:conversation": "pnpm --filter @yuiju/character-runtime run dev:conversation",
    "dev:character-runtime:agent": "pnpm --filter @yuiju/character-runtime run dev:agent",
    "dev:world-simulator": "pnpm --filter @yuiju/world-simulator run dev",
    "type-check:dashboard": "pnpm --filter @yuiju/dashboard run type-check",
    "type-check:character-runtime": "pnpm --filter @yuiju/character-runtime run type-check",
    "type-check:world-simulator": "pnpm --filter @yuiju/world-simulator run type-check",
    "type-check": "pnpm run type-check:dashboard && pnpm run type-check:character-runtime && pnpm run type-check:world-simulator && pnpm run type-check:shared && pnpm run type-check:interaction",
    "docs:dev": "pnpm --filter @yuiju/site run dev",
    "docs:build": "pnpm --filter @yuiju/site run build",
    "docs:preview": "pnpm --filter @yuiju/site run preview",
    "image": "node --use-env-proxy packages/source/aigc/pixel/generate/generate-image.js",
    "generate:extensions": "pnpm --filter @yuiju/shared run generate:extensions",
    "type-check:shared": "pnpm --filter @yuiju/shared run type-check",
    "type-check:interaction": "pnpm --filter yuiju-interaction run type-check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yixiaojiu/yuiju.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/yixiaojiu/yuiju/issues"
  },
  "homepage": "https://github.com/yixiaojiu/yuiju#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.0",
    "@types/react": "catalog:",
    "@types/ws": "^8.18.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pm2": "^6.0.14",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.4",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/typesafe-ai": "3.0.30",
    "@hono/node-server": "1.19.11",
    "@langfuse/otel": "^5.10.0",
    "@langfuse/vercel-ai-sdk": "^5.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@qdrant/js-client-rest": "~1.16.0",
    "@types/mongoose": "^5.11.97",
    "@yuiju/shared": "workspace:*",
    "ai": "7.0.157",
    "bullmq": "^6.3.11",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "hono": "catalog:",
    "ioredis": "^5.8.2",
    "lodash-es": "^4.17.21",
    "mongoose": "^8.20.0",
    "node-cron": "^4.2.1",
    "node-napcat-ts": "^0.4.23",
    "react": "catalog:",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.1",
    "yuiju-interaction": "workspace:*",
    "zod": "^4.1.13"
  }
}
